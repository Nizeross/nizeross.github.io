{
  "name": "nizeross-blog-quality",
  "private": true,
  "version": "1.0.0",
  "description": "Development-only quality checks for a Hugo static blog",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "lint": "markdownlint-cli2",
    "test:e2e": "node scripts/test-browser.cjs",
    "browsers": "node scripts/install_browser.cjs",
    "test:workflows": "node --test tests/workflows.test.cjs",
    "verify": "node scripts/verify.cjs",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "markdownlint-cli2": "0.24.0",
    "katex": "0.19.1",
    "mermaid": "11.17.2",
    "esbuild": "0.28.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "re2js": "2.9.1",
    "katex": "0.19.1",
    "dompurify": "3.4.17",
    "lodash-es": "4.18.1"
  }
}
